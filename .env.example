# StockPilot environment configuration
#
# Copy this file to `.env` and choose ONE way to connect to Shopify:
#
#   1) TOKEN MODE (simplest) — a custom-app Admin API access token. No OAuth or
#      public tunnel needed. Best for an internal tool you run yourself.
#      Set SHOPIFY_STORE_DOMAIN + SHOPIFY_ADMIN_TOKEN below.
#
#   2) OAUTH MODE — the full embedded-app flow. Set SHOPIFY_API_KEY/SECRET +
#      SHOPIFY_APP_URL (requires a public tunnel in dev).
#
# If neither is set (or STOCKPILOT_USE_MOCK=true), StockPilot runs in MOCK MODE
# with demo data so you can explore the whole app without a live store.

# --- Option 1: Custom-app Admin API token (TOKEN MODE) ---
# In Shopify admin: Settings > Apps and sales channels > Develop apps >
# create an app > configure Admin API scopes (read_products, read_inventory,
# write_inventory, read_locations, read_orders) > Install > reveal the
# Admin API access token (starts with `shpat_`).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
# Admin API version to call (optional).
# SHOPIFY_ADMIN_API_VERSION=2025-10

# --- Option 2: Shopify embedded app (OAUTH MODE) ---
# From your app in the Shopify Partner Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated access scopes the app requests.
SCOPES=read_products,read_inventory,write_inventory,read_locations,read_orders

# The public URL where this app is hosted (tunnel URL in dev, e.g. from the
# Shopify CLI or ngrok/cloudflared).
SHOPIFY_APP_URL=

# Optional custom storefront domain for the dev store.
# SHOP_CUSTOM_DOMAIN=

# --- StockPilot options ---
# Force mock mode even when credentials are present (useful for demos/e2e).
STOCKPILOT_USE_MOCK=false

# Shared secret for the manual webhook HMAC check (token/offline mode).
SHOPIFY_WEBHOOK_SECRET=

# Where StockPilot persists thresholds and activity history (optional).
# STOCKPILOT_DATA_FILE=.data/store.json
